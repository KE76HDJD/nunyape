{
  "dashboard": {
    "id": null,
    "title": "Payment Metrics",
    "tags": ["payment", "business"],
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "Payment Success Rate",
        "type": "stat",
        "targets": [
          {
            "expr": "rate(payment_requests_total{status=\"success\"}[5m]) / rate(payment_requests_total[5m]) * 100",
            "legendFormat": "Success Rate"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent"
          }
        }
      }
    ],
    "time": {
      "from": "now-6h",
      "to": "now"
    }
  }
}